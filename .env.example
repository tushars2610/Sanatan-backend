# Application Configuration
APP_ENV=development
APP_NAME=SpiritualSakha
APP_VERSION=1.0.0
DEBUG=True

# Database (PostgreSQL asyncpg connection)
DATABASE_URL=postgresql+asyncpg://sakha:sakha_dev_password@postgres:5432/spiritualsakha
POSTGRES_DB=spiritualsakha
POSTGRES_USER=sakha
POSTGRES_PASSWORD=sakha_dev_password

# Redis Cache & Broker
REDIS_URL=redis://redis:6379/0

# Authentication & Security
JWT_SECRET=spiritualsakha_dev_secret_key_change_in_production_32chars
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=30
ALGORITHM=HS256

# Google Gemini AI Configuration
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-pro

# Astrology Configuration
DEFAULT_TIMEZONE=Asia/Kolkata
ASTROLOGY_AYANAMSA=LAHIRI
